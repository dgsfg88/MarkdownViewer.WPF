<Window x:Class="MarkdownViewer.WPF.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml"
        xmlns:local="clr-namespace:MarkdownViewer.WPF.View"
		xmlns:viewModel="clr-namespace:MarkdownViewer.WPF.ViewModel"
		d:DataContext="{d:DesignInstance Type=viewModel:MainWindowViewModel, IsDesignTimeCreatable=False}" 
        mc:Ignorable="d"
        Title="Markdown Viewer" Height="450" Width="800">
    <Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="auto"/>
			<RowDefinition/>
		</Grid.RowDefinitions>
		<UniformGrid Rows="1">
			<Button Command="{Binding OpenFileCommand}">
				<Viewbox MaxHeight="1cm">
					<TextBlock Text="Open"/>
				</Viewbox>
			</Button>
		</UniformGrid>
		<mdxam:MarkdownScrollViewer xml:space="preserve" VerticalScrollBarVisibility="Auto"
									Grid.Row="1"
									Markdown="{Binding Path=MarkdownText, Mode=OneWay}"/>
    </Grid>
</Window>
